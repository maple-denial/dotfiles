#!/bin/sh
# 依据 dot_config/yazi/package.toml 安装 yazi 的 flavor / 插件
# 下面这行哈希让本脚本只在 package.toml 变化时重跑：
# {{ include "dot_config/yazi/package.toml" | sha256sum }}
set -u

if command -v ya >/dev/null 2>&1; then
    ya pkg install || echo "警告：ya pkg install 失败（可能无网络），稍后可手动重试：ya pkg install" >&2
else
    echo "警告：未找到 ya，跳过 yazi 包安装；安装 yazi 后手动执行 ya pkg install" >&2
fi
exit 0
